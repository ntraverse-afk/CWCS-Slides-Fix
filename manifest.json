{
  "manifest_version": 3,
  "name": "CWCS-Slides-Fix",
  "version": "1.2",
  "description": "Fixes interface issues with google slides",
  "permissions": [
   "webRequest",
   "webRequestBlocking"
  ],
  "host_permissions": [
	"https://docs.google.com/*",
	"https://slides.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
